_Chutzpah*

*.sbr
*.tlb
*.scc
*.tli
*.tlh
*.svclog
*.log
.builds
*.pidb
*.tlog
*.vspscc
*.vssscc
*.tmp
*.tmp_proj
*_wpftmp.csproj


# MSTest test Results
# Build results on 'Bin' directories
# Visual Studio 2017 auto generated files
Generated\ Files/
**/[Bb]in/*
